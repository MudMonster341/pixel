{
  "name": "pixel-quest",
  "version": "0.1.0",
  "private": true,
  "description": "Small top-down pixel RPG exploration game (Phaser 3)",
  "scripts": {
    "start": "node server.js",
    "assets": "node tools/make-assets.js && node tools/make-cutscenes.js && node tools/make-minigame-art.js",
    "cutscenes": "node tools/make-cutscenes.js",
    "minigame-art": "node tools/make-minigame-art.js",
    "campus": "node tools/campus/build-campus.js",
    "interiors": "node tools/interiors/build-interiors.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "feedback": "node tools/feedback.js",
    "qa:shots": "node tools/qa-shots.js",
    "qa:shots:intro": "node tools/qa-shots-intro.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
